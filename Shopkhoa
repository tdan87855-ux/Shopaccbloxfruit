<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BloxVip Shop — Bán Acc & Dịch Vụ Cày Thuê Blox Fruits</title>
<meta name="description" content="Shop bán tài khoản Blox Fruits uy tín, dịch vụ cày thuê level max, race v3, Godhuman, CDK, raid awakening giá rẻ, nhanh chóng, bảo hành dài hạn.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#070b14;
  --bg2:#0d1424;
  --card:#111a2e;
  --card2:#162138;
  --line:rgba(255,255,255,.08);
  --gold:#ffc93c;
  --gold2:#f5a623;
  --red:#ff4d5e;
  --red2:#e63946;
  --teal:#2dd4bf;
  --text:#e8ecf5;
  --muted:#8b95ad;
  --radius:16px;
  --shadow:0 10px 40px rgba(0,0,0,.45);
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  font-family:'Be Vietnam Pro',system-ui,sans-serif;
  background:var(--bg);
  color:var(--text);
  overflow-x:hidden;
  line-height:1.6;
}
#bg-canvas{position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.55}
.glow{position:fixed;border-radius:50%;filter:blur(120px);z-index:0;pointer-events:none;opacity:.35}
.glow.a{width:480px;height:480px;background:#ff4d5e;top:-120px;right:-100px}
.glow.b{width:520px;height:520px;background:#f5a623;bottom:-160px;left:-140px;opacity:.22}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px;position:relative;z-index:2}

/* ===== HEADER ===== */
header{
  position:fixed;top:0;left:0;right:0;z-index:50;
  backdrop-filter:blur(14px);
  background:rgba(7,11,20,.72);
  border-bottom:1px solid var(--line);
  transition:.3s;
}
header.scrolled{box-shadow:0 6px 30px rgba(0,0,0,.5)}
.nav{display:flex;align-items:center;justify-content:space-between;height:68px}
.logo{display:flex;align-items:center;gap:10px;font-weight:900;font-size:20px;letter-spacing:.5px;text-decoration:none;color:var(--text)}
.logo .mark{
  width:38px;height:38px;border-radius:10px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--gold),var(--red2));
  font-size:20px;box-shadow:0 4px 14px rgba(245,166,35,.4);
}
.logo b{background:linear-gradient(90deg,var(--gold),var(--red));-webkit-background-clip:text;background-clip:text;color:transparent}
.nav-links{display:flex;gap:6px;align-items:center}
.nav-links a{
  color:var(--muted);text-decoration:none;font-weight:600;font-size:14.5px;
  padding:8px 14px;border-radius:10px;transition:.25s;
}
.nav-links a:hover{color:var(--text);background:rgba(255,255,255,.06)}
.nav-cta{display:flex;gap:10px;align-items:center}
.btn{
  display:inline-flex;align-items:center;gap:8px;
  padding:11px 22px;border-radius:12px;font-weight:700;font-size:14.5px;
  text-decoration:none;border:none;cursor:pointer;transition:.25s;font-family:inherit;
}
.btn-gold{background:linear-gradient(135deg,var(--gold),var(--gold2));color:#1a1205;box-shadow:0 6px 20px rgba(245,166,35,.35)}
.btn-gold:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(245,166,35,.5)}
.btn-red{background:linear-gradient(135deg,var(--red),var(--red2));color:#fff;box-shadow:0 6px 20px rgba(230,57,70,.35)}
.btn-red:hover{transform:translateY(-2px);box-shadow:0 10px 28px rgba(230,57,70,.5)}
.btn-ghost{background:rgba(255,255,255,.06);color:var(--text);border:1px solid var(--line)}
.btn-ghost:hover{background:rgba(255,255,255,.12)}
.cart-btn{
  position:relative;background:rgba(255,255,255,.06);border:1px solid var(--line);
  width:44px;height:44px;border-radius:12px;display:grid;place-items:center;cursor:pointer;color:var(--text);transition:.25s;
}
.cart-btn:hover{background:rgba(255,255,255,.12)}
.cart-count{
  position:absolute;top:-6px;right:-6px;min-width:20px;height:20px;padding:0 5px;
  background:var(--red);color:#fff;border-radius:10px;font-size:11px;font-weight:800;
  display:grid;place-items:center;border:2px solid var(--bg);
}
.burger{display:none;background:none;border:none;color:var(--text);font-size:24px;cursor:pointer}

/* ===== HERO ===== */
.hero{padding:140px 0 80px;position:relative}
.hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:50px;align-items:center}
.tag{
  display:inline-flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;
  background:rgba(255,201,60,.1);border:1px solid rgba(255,201,60,.3);
  color:var(--gold);font-size:13px;font-weight:700;margin-bottom:22px;
}
.tag .dot{width:8px;height:8px;border-radius:50%;background:#22c55e;box-shadow:0 0 10px #22c55e;animation:pulse 1.6s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.hero h1{
  font-size:clamp(34px,5.2vw,58px);font-weight:900;line-height:1.12;letter-spacing:-.5px;margin-bottom:20px;
}
.hero h1 .grad{background:linear-gradient(90deg,var(--gold),var(--red));-webkit-background-clip:text;background-clip:text;color:transparent}
.hero p{color:var(--muted);font-size:17px;max-width:520px;margin-bottom:30px}
.hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:34px}
.hero-stats{display:flex;gap:30px;flex-wrap:wrap}
.hstat b{display:block;font-size:26px;font-weight:900;color:var(--gold)}
.hstat span{font-size:13px;color:var(--muted)}
.hero-art{position:relative;display:grid;place-items:center;min-height:380px}
.orb{
  width:300px;height:300px;border-radius:50%;position:relative;
  background:radial-gradient(circle at 30% 30%,#1e2c4d,#0a1122 70%);
  border:1px solid rgba(255,201,60,.25);
  box-shadow:0 0 80px rgba(245,166,35,.18), inset 0 0 60px rgba(0,0,0,.6);
  display:grid;place-items:center;animation:float 5s ease-in-out infinite;
}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-16px)}}
.orb .big{font-size:110px;filter:drop-shadow(0 10px 30px rgba(0,0,0,.6))}
.chip{
  position:absolute;background:var(--card);border:1px solid var(--line);
  padding:10px 16px;border-radius:12px;font-size:13px;font-weight:700;
  box-shadow:var(--shadow);display:flex;align-items:center;gap:8px;white-space:nowrap;
}
.chip.c1{top:8%;left:-6%;animation:float 4s ease-in-out infinite}
.chip.c2{top:38%;right:-10%;animation:float 4.6s .4s ease-in-out infinite}
.chip.c3{bottom:6%;left:2%;animation:float 5.2s .8s ease-in-out infinite}
.chip .ic{font-size:20px}

/* ===== SECTION ===== */
section{padding:70px 0;position:relative;z-index:2}
.sec-head{text-align:center;max-width:640px;margin:0 auto 44px}
.sec-head .kicker{color:var(--gold);font-weight:800;font-size:13px;letter-spacing:2px;text-transform:uppercase;margin-bottom:10px}
.sec-head h2{font-size:clamp(26px,3.6vw,38px);font-weight:900;margin-bottom:12px}
.sec-head p{color:var(--muted)}

/* ===== TABS ===== */
.tabs{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-bottom:30px}
.tab{
  padding:11px 24px;border-radius:12px;background:var(--card);border:1px solid var(--line);
  color:var(--muted);font-weight:700;font-size:14.5px;cursor:pointer;transition:.25s;font-family:inherit;
}
.tab:hover{color:var(--text)}
.tab.active{background:linear-gradient(135deg,var(--gold),var(--gold2));color:#1a1205;border-color:transparent;box-shadow:0 6px 20px rgba(245,166,35,.3)}
.filters{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-bottom:34px}
.filter{
  padding:7px 16px;border-radius:999px;background:transparent;border:1px solid var(--line);
  color:var(--muted);font-size:13px;font-weight:600;cursor:pointer;transition:.25s;font-family:inherit;
}
.filter.active{background:rgba(45,212,191,.12);border-color:var(--teal);color:var(--teal)}

/* ===== PRODUCT GRID ===== */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:20px}
.pcard{
  background:linear-gradient(160deg,var(--card),var(--card2));
  border:1px solid var(--line);border-radius:var(--radius);padding:22px;
  transition:.3s;position:relative;overflow:hidden;display:flex;flex-direction:column;
}
.pcard:hover{transform:translateY(-6px);border-color:rgba(255,201,60,.4);box-shadow:0 18px 40px rgba(0,0,0,.5)}
.pcard::before{
  content:'';position:absolute;top:0;left:0;right:0;height:3px;
  background:linear-gradient(90deg,var(--gold),var(--red));opacity:0;transition:.3s;
}
.pcard:hover::before{opacity:1}
.pcard .badge{
  position:absolute;top:14px;right:14px;padding:4px 10px;border-radius:999px;
  font-size:11px;font-weight:800;letter-spacing:.5px;
}
.badge.hot{background:rgba(255,77,94,.15);color:var(--red);border:1px solid rgba(255,77,94,.4)}
.badge.new{background:rgba(45,212,191,.15);color:var(--teal);border:1px solid rgba(45,212,191,.4)}
.badge.sale{background:rgba(255,201,60,.15);color:var(--gold);border:1px solid rgba(255,201,60,.4)}
.pcard .pic{
  height:110px;display:grid;place-items:center;font-size:56px;margin-bottom:14px;
  background:radial-gradient(circle,rgba(255,201,60,.08),transparent 70%);border-radius:12px;
}
.pcard h3{font-size:17px;font-weight:800;margin-bottom:8px}
.pcard .feats{list-style:none;margin-bottom:16px;flex:1}
.pcard .feats li{font-size:13px;color:var(--muted);padding:3px 0;display:flex;align-items:center;gap:8px}
.pcard .feats li::before{content:'✓';color:var(--teal);font-weight:900}
.pcard .price-row{display:flex;align-items:baseline;gap:8px;margin-bottom:14px}
.pcard .price{font-size:22px;font-weight:900;color:var(--gold)}
.pcard .old{font-size:13px;color:var(--muted);text-decoration:line-through}
.pcard .add{
  width:100%;padding:11px;border-radius:10px;background:rgba(255,201,60,.12);
  border:1px solid rgba(255,201,60,.35);color:var(--gold);font-weight:800;font-size:14px;
  cursor:pointer;transition:.25s;font-family:inherit;
}
.pcard .add:hover{background:linear-gradient(135deg,var(--gold),var(--gold2));color:#1a1205}
.empty{grid-column:1/-1;text-align:center;color:var(--muted);padding:40px}

/* ===== STEPS ===== */
.steps{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.step{
  background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  padding:26px 22px;position:relative;transition:.3s;
}
.step:hover{transform:translateY(-4px);border-color:rgba(255,201,60,.35)}
.step .num{
  width:44px;height:44px;border-radius:12px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--gold),var(--red2));color:#fff;
  font-weight:900;font-size:18px;margin-bottom:16px;box-shadow:0 6px 16px rgba(245,166,35,.3);
}
.step h4{font-size:16px;font-weight:800;margin-bottom:8px}
.step p{font-size:13.5px;color:var(--muted)}

/* ===== WHY ===== */
.why{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:20px}
.wcard{
  background:linear-gradient(160deg,var(--card),var(--card2));border:1px solid var(--line);
  border-radius:var(--radius);padding:26px;transition:.3s;
}
.wcard:hover{border-color:rgba(45,212,191,.4);transform:translateY(-4px)}
.wcard .ic{font-size:34px;margin-bottom:14px;display:block}
.wcard h4{font-size:16px;font-weight:800;margin-bottom:8px}
.wcard p{font-size:13.5px;color:var(--muted)}

/* ===== FAQ ===== */
.faq{max-width:760px;margin:0 auto}
.faq-item{background:var(--card);border:1px solid var(--line);border-radius:14px;margin-bottom:12px;overflow:hidden}
.faq-q{
  width:100%;padding:18px 22px;background:none;border:none;color:var(--text);
  font-family:inherit;font-weight:700;font-size:15px;cursor:pointer;
  display:flex;justify-content:space-between;align-items:center;gap:14px;text-align:left;
}
.faq-q .arr{transition:.3s;color:var(--gold);flex-shrink:0;font-size:18px}
.faq-item.open .arr{transform:rotate(45deg)}
.faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease}
.faq-a p{padding:0 22px 18px;color:var(--muted);font-size:14px}

/* ===== CONTACT ===== */
.contact-box{
  background:linear-gradient(160deg,var(--card),var(--card2));border:1px solid rgba(255,201,60,.25);
  border-radius:24px;padding:50px 40px;text-align:center;position:relative;overflow:hidden;
}
.contact-box::before{
  content:'';position:absolute;inset:0;
  background:radial-gradient(circle at 20% 0%,rgba(255,201,60,.12),transparent 50%),
             radial-gradient(circle at 80% 100%,rgba(255,77,94,.12),transparent 50%);
}
.contact-box > *{position:relative}
.contact-box h2{font-size:clamp(24px,3.4vw,34px);font-weight:900;margin-bottom:12px}
.contact-box p{color:var(--muted);margin-bottom:30px;max-width:520px;margin-left:auto;margin-right:auto}
.contact-links{display:flex;gap:14px;justify-content:center;flex-wrap:wrap}
.cbtn{
  display:inline-flex;align-items:center;gap:10px;padding:14px 26px;border-radius:14px;
  font-weight:800;font-size:15px;text-decoration:none;color:#fff;transition:.25s;
}
.cbtn:hover{transform:translateY(-3px)}
.cbtn.zalo{background:#0068ff;box-shadow:0 8px 24px rgba(0,104,255,.4)}
.cbtn.fb{background:#1877f2;box-shadow:0 8px 24px rgba(24,119,242,.4)}
.cbtn.discord{background:#5865f2;box-shadow:0 8px 24px rgba(88,101,242,.4)}
.cbtn.tg{background:#229ed9;box-shadow:0 8px 24px rgba(34,158,217,.4)}

/* ===== FOOTER ===== */
footer{border-top:1px solid var(--line);padding:40px 0 30px;margin-top:40px;position:relative;z-index:2}
.foot{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:20px}
.foot p{color:var(--muted);font-size:13px}
.foot .note{font-size:12px;color:#5a6478;max-width:520px}

/* ===== CART DRAWER ===== */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(4px);z-index:90;opacity:0;pointer-events:none;transition:.3s}
.overlay.show{opacity:1;pointer-events:auto}
.drawer{
  position:fixed;top:0;right:0;bottom:0;width:min(420px,100%);background:var(--bg2);
  border-left:1px solid var(--line);z-index:100;transform:translateX(105%);transition:.35s cubic-bezier(.4,0,.2,1);
  display:flex;flex-direction:column;
}
.drawer.show{transform:translateX(0)}
.drawer-head{padding:22px;border-bottom:1px solid var(--line);display:flex;justify-content:space-between;align-items:center}
.drawer-head h3{font-size:18px;font-weight:800}
.close-x{background:none;border:none;color:var(--muted);font-size:26px;cursor:pointer;line-height:1}
.close-x:hover{color:var(--text)}
.drawer-body{flex:1;overflow-y:auto;padding:16px 22px}
.citem{display:flex;gap:14px;align-items:center;padding:14px 0;border-bottom:1px solid var(--line)}
.citem .ci{font-size:32px;width:48px;height:48px;display:grid;place-items:center;background:var(--card);border-radius:10px;flex-shrink:0}
.citem .info{flex:1;min-width:0}
.citem .info b{display:block;font-size:14px;font-weight:700;margin-bottom:2px}
.citem .info span{font-size:13px;color:var(--gold);font-weight:800}
.qty{display:flex;align-items:center;gap:8px}
.qty button{width:26px;height:26px;border-radius:8px;background:var(--card);border:1px solid var(--line);color:var(--text);cursor:pointer;font-weight:800}
.qty span{min-width:20px;text-align:center;font-weight:700;font-size:14px}
.rm{background:none;border:none;color:var(--red);cursor:pointer;font-size:18px;padding:4px}
.drawer-foot{padding:20px 22px;border-top:1px solid var(--line)}
.total-row{display:flex;justify-content:space-between;margin-bottom:6px;font-size:14px;color:var(--muted)}
.total-row.final{font-size:18px;font-weight:900;color:var(--text);margin-bottom:16px}
.total-row.final b{color:var(--gold);font-size:20px}
.drawer-foot .btn{width:100%;justify-content:center;margin-bottom:10px}
.empty-cart{text-align:center;color:var(--muted);padding:60px 20px;font-size:14px}

/* ===== TOAST ===== */
.toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(100px);
  background:var(--card);border:1px solid rgba(45,212,191,.4);color:var(--text);
  padding:14px 24px;border-radius:12px;font-weight:700;font-size:14px;z-index:200;
  box-shadow:var(--shadow);transition:.4s;display:flex;align-items:center;gap:10px;
}
.toast.show{transform:translateX(-50%) translateY(0)}

/* ===== REVEAL ===== */
.reveal{opacity:0;transform:translateY(30px);transition:.7s cubic-bezier(.2,.7,.3,1)}
.reveal.in{opacity:1;transform:none}

/* ===== MOBILE ===== */
@media(max-width:860px){
  .hero-grid{grid-template-columns:1fr;gap:30px}
  .hero-art{min-height:320px;order:-1}
  .orb{width:240px;height:240px}
  .orb .big{font-size:88px}
  .nav-links{
    position:fixed;top:68px;left:0;right:0;background:var(--bg2);
    flex-direction:column;align-items:stretch;padding:14px 20px;gap:4px;
    border-bottom:1px solid var(--line);transform:translateY(-130%);transition:.3s;
  }
  .nav-links.open{transform:translateY(0)}
  .nav-links a{padding:12px 14px}
  .burger{display:block}
  .hero{padding:110px 0 50px}
  .contact-box{padding:36px 22px}
  .chip.c2{right:-2%}
}
.sample-note{
  text-align:center;font-size:12px;color:#5a6478;margin-top:14px;
}
/* ===== INPUTS & MODALS ===== */
.input{width:100%;padding:12px 14px;border-radius:10px;background:var(--bg);border:1px solid var(--line);color:var(--text);font-family:inherit;font-size:14px;outline:none;transition:.2s}
.input:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(255,201,60,.15)}
label.flabel{display:block;font-size:12.5px;font-weight:700;color:var(--muted);margin:12px 0 6px}
.modal{position:fixed;inset:0;z-index:120;display:none;align-items:center;justify-content:center;padding:20px}
.modal.show{display:flex}
.modal-card{background:var(--bg2);border:1px solid var(--line);border-radius:20px;width:min(440px,100%);max-height:90vh;overflow-y:auto;padding:28px;position:relative;box-shadow:0 30px 80px rgba(0,0,0,.6);animation:pop .3s cubic-bezier(.2,.9,.3,1.2)}
@keyframes pop{from{transform:scale(.92);opacity:0}to{transform:scale(1);opacity:1}}
.modal-card.wide{width:min(560px,100%)}
.modal h3{font-size:20px;font-weight:900;margin-bottom:4px}
.modal .sub{color:var(--muted);font-size:13px;margin-bottom:8px}
.modal-x{position:absolute;top:16px;right:18px;background:none;border:none;color:var(--muted);font-size:24px;cursor:pointer;line-height:1}
.modal-x:hover{color:var(--text)}
.tabs2{display:flex;gap:6px;background:var(--bg);padding:5px;border-radius:12px;margin:16px 0}
.tabs2 button{flex:1;padding:10px;border:none;background:none;color:var(--muted);font-weight:800;font-size:14px;border-radius:9px;cursor:pointer;font-family:inherit;transition:.2s}
.tabs2 button.active{background:linear-gradient(135deg,var(--gold),var(--gold2));color:#1a1205}
.err{color:var(--red);font-size:12.5px;margin-top:8px;min-height:16px;font-weight:600}
.user-chip{display:inline-flex;align-items:center;gap:8px;padding:9px 14px;border-radius:12px;background:rgba(45,212,191,.12);border:1px solid rgba(45,212,191,.4);color:var(--teal);font-weight:800;font-size:13.5px;cursor:pointer;position:relative;font-family:inherit}
.user-chip .ava{width:24px;height:24px;border-radius:50%;background:linear-gradient(135deg,var(--teal),#0d9488);display:grid;place-items:center;font-size:13px;color:#04241f;font-weight:900}
.dropdown{position:absolute;top:calc(100% + 10px);right:0;background:var(--bg2);border:1px solid var(--line);border-radius:14px;min-width:210px;padding:8px;box-shadow:var(--shadow);opacity:0;pointer-events:none;transform:translateY(-8px);transition:.2s;z-index:60;text-align:left}
.dropdown.show{opacity:1;pointer-events:auto;transform:none}
.dropdown button{width:100%;text-align:left;padding:10px 12px;background:none;border:none;color:var(--text);font-size:13.5px;font-weight:600;border-radius:9px;cursor:pointer;font-family:inherit;display:flex;gap:10px;align-items:center}
.dropdown button:hover{background:rgba(255,255,255,.06)}
.dropdown .duser{padding:8px 12px 10px;font-size:12px;color:var(--muted);border-bottom:1px solid var(--line);margin-bottom:4px;line-height:1.5}
